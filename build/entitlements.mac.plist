<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Mikrofon: bez tego nagrywanie w podpisanej aplikacji nie ruszy. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Electron wymaga JIT i pamięci wykonywalnej. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- uiohook-napi jest modułem natywnym ładowanym w czasie działania. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Symulacja ⌘V i podsłuch skrótu idą przez zdarzenia systemowe. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
